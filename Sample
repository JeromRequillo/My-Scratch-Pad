    ; --- GUI INTERNAL FUNCTIONS ---
    
    UpdatePreview(*) {
        temp_preview := GenerateInvoice(guiCtrl_Prefix.Value, guiCtrl_Num.Value, guiCtrl_Suffix.Value)
        guiCtrl_PreviewText.Value := "Preview: " . temp_preview
    }

    ; Helper para isalin ang piniling Dropdown text papuntang AHK Modifier Symbology
    GetModifierSymbol(modText) {
        if InStr(modText, "Alt") return "!"
        if InStr(modText, "Ctrl") return "^"
        if InStr(modText, "Shift") return "+"
        if InStr(modText, "Win") return "#"
        return "" ; None
    }

    SelectHotkey(CtrlObj, RowNumber) {
        if (RowNumber == 0)
            return
        
        fullKey := CtrlObj.GetText(RowNumber, 1)
        editTxt.Value := CtrlObj.GetText(RowNumber, 2)
        
        ; I-decode ang nakaimbak na key para mag-reflect pabalik sa mga dropdowns
        modPart := ""
        keyPart := fullKey
        
        if (SubStr(fullKey, 1, 1) = "!" || SubStr(fullKey, 1, 1) = "^" || SubStr(fullKey, 1, 1) = "+" || SubStr(fullKey, 1, 1) = "#") {
            modPart := SubStr(fullKey, 1, 1)
            keyPart := SubStr(fullKey, 2)
        }
        
        ; Itakda ang angkop na Modifier Dropdown row index
        if (modPart == "!") ddlMod.Choose(1)
        else if (modPart == "^") ddlMod.Choose(2)
        else if (modPart == "+") ddlMod.Choose(3)
        else if (modPart == "#") ddlMod.Choose(4)
        else ddlMod.Choose(5)
        
        ; Hanapin at piliin ang katumbas na Key sa Key Dropdown listahan
        Loop keyList.Length {
            if (keyList[A_Index] = keyPart) {
                ddlKey.Choose(A_Index)
                break
            }
        }
    }

    AddUpdateHotkey(*) {
        if (editTxt.Value == "") {
            MsgBox("Paki-sulat muna ang Text to Output!", "Babala", 48)
            return
        }
        
        ; Buuin ang hotkey combination string mula sa dalawang Dropdowns
        chosenModSymbol := GetModifierSymbol(ddlMod.Text)
        constructedKey := chosenModSymbol . ddlKey.Text
        
        rowToUpdate := 0
        Loop LV.GetCount() {
            if (LV.GetText(A_Index, 1) = constructedKey) {
                rowToUpdate := A_Index
                break
            }
        }
        
        if (rowToUpdate > 0) {
            LV.Modify(rowToUpdate, , constructedKey, editTxt.Value)
        } else {
            LV.Add(, constructedKey, editTxt.Value)
        }
        
        editTxt.Value := ""
        ddlMod.Choose(1)
        ddlKey.Choose(1)
    }

    DeleteHotkey(*) {
        selectedRow := LV.GetNext()
        if (selectedRow == 0) {
            MsgBox("Pumili muna ng hotkey sa listahan na gustong burahin.", "Babala", 48)
            return
        }
        LV.Delete(selectedRow)
        editTxt.Value := ""
    }

    SaveSettings(*) {
        global prefix, current_num, suffix, hotkeyList

        if (guiCtrl_Num.Value == "") {
            MsgBox("'Next Number' cannot be empty!", "Error", 48)
            return
        }
        
        prefix := guiCtrl_Prefix.Value
        current_num := Format("{:07}", Number(guiCtrl_Num.Value)) ; Naka-sync na sa 7-digit padding standard
        suffix := guiCtrl_Suffix.Value
        
        IniWrite(prefix, "settings.ini", "Settings", "Prefix")
        IniWrite(Number(guiCtrl_Num.Value), "settings.ini", "Sequence", "LastNumber")
        IniWrite(suffix, "settings.ini", "Settings", "Suffix")
        
        try IniDelete("settings.ini", "Hotkeys")
        
        hotkeyList := [] 
        Loop LV.GetCount() {
            hKey := LV.GetText(A_Index, 1)
            hTxt := LV.GetText(A_Index, 2)
            
            IniWrite(hTxt, "settings.ini", "Hotkeys", hKey)
            hotkeyList.Push({key: hKey, txt: hTxt})
        }
        
        RegisterCustomHotkeys()
        
        MsgBox("All settings and dynamic hotkeys updated successfully!", "Success", "64 T1.5")
        mainGui.Destroy()
    }
}
