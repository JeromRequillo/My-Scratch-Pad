#Requires AutoHotkey v2.0
#SingleInstance Force

; ==============================================================================
; USER CONFIGURATION 
; ==============================================================================
global ServerFolder := "C:\Path\To\Your\Server\Folder"  
global LocalFolder  := "C:\Users\Username\Desktop\MyFolder" 

; ==============================================================================
; HOTKEY TRIGGER: Pindutin ang F8 para simulan ang proseso
; ==============================================================================
F8:: {
    
    if !DirExist(ServerFolder) {
        MsgBox("Error: Hindi mahanap ang Server Folder.`nPakicheck ang path: " ServerFolder, "Error", 48)
        return
    }
    if !DirExist(LocalFolder) {
        
        DirCreate(LocalFolder)
    }

    FileCount := 0
    ErrorCount := 0

    
    LoopFiles ServerFolder "\*.*" {
        SourceFile := A_LoopFilePath
        DestFile := LocalFolder "\" A_LoopFileName

        try {
            
            FileCopy(SourceFile, DestFile, 1)
            
            
            FileDelete(SourceFile)
            
            FileCount++
        } catch as err {
            ErrorCount++
            
            continue
        }
    }

    ; ==============================================================================
    ; NOTIFICATION 
    ; ==============================================================================
    if (FileCount > 0) {
        MsgBox(FileCount " (na) file ang matagumpay na nailipat sa Desktop!`nMga nagka-error: " ErrorCount, "Success", 64)
    } else if (ErrorCount > 0) {
        MsgBox("Walang file na nailipat. " ErrorCount " (na) file ang naka-lock o may error.", "Warning", 48)
    } else {
        
        ToolTip("Walang file na nahanap sa server.")
        SetTimer () => ToolTip(), -2000 
    }
}
