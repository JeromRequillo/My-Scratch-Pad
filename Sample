#NoEnv
#SingleInstance Force
SendMode Input
SetWorkingDir %A_ScriptDir%

global current_num, prefix, suffix, pad_length := 7, last_generated := "None"
global GuiHwnd

LoadSettings()
return 

; --- FUNCTIONS ---

LoadSettings() {
    IniRead, current_num, settings.ini, Sequence, LastNumber, 00000
    IniRead, prefix, settings.ini, Settings, Prefix, AAPI
    IniRead, suffix, settings.ini, Settings, Suffix, S
    ; Naka-hardlock na sa 7 digits para hindi mag-bago-bago
    pad_length := 7
}

GenerateInvoice(p := "", n := "", s := "") {
    target_prefix := (p == "") ? prefix : p
    target_num    := (n == "") ? current_num : n
    target_suffix := (s == "") ? suffix : s
    
    numeric_val := target_num + 0
    format_string := "{:0" . pad_length . "}"
    formatted_num := Format(format_string, numeric_val)
    
    return target_prefix . formatted_num . target_suffix
}

; --- HOTKEYS ---

!F9::
    Critical 
    invoice_string := GenerateInvoice()
    SendInput, %invoice_string%
    
    SoundBeep, 750, 50 
    ToolTip, Sent: %invoice_string%
    SetTimer, RemoveToolTip, -2000
    
    last_generated := invoice_string
    current_num += 1
    IniWrite, %current_num%, settings.ini, Sequence, LastNumber
    IniWrite, %last_generated%, settings.ini, Sequence, LastGenerated
return

RemoveToolTip:
    ToolTip
return

; --- PREMIUM LIGHT GUI (Alt + F10) ---

!F10::
    LoadSettings() 
    Gui, Destroy 
    
    ; Modern Borderless Frame
    Gui, +LastFound -Caption +AlwaysOnTop +HwndGuiHwnd
    
    ; PREMIUM LIGHT PALETTE: Pure White Background, Soft Silver-Gray Edges
    Gui, Color, FFFFFF, F1F3F5
    
    ; --- CUSTOM MINIMALIST TITLE BAR ---
    Gui, Font, b s10 c495057, Segoe UI
    Gui, Add, Text, x15 y14 w200 h20 +BackgroundTrans vTitleText, INVOICE SUITE PRO
    
    ; Premium Close Button (Muted Gray na magiging malinis tingnan)
    Gui, Font, Norm s14 c868E96
    Gui, Add, Text, x300 y10 w25 h20 Center gGuiClose +BackgroundTrans +gGuiClose, ×
    
    ; Minimalist Slate Teal Top Accent Line
    Gui, Add, Progress, x0 y42 w330 h3 Background0CA678 c0CA678, 100
    
    ; --- MAIN EDIT CONTROLS ---
    Gui, Font, b s9 c495057, Segoe UI
    
    ; Prefix
    Gui, Add, Text, x20 y68 w90 h25 +0x200 +BackgroundTrans, PREFIX
    Gui, Font, Norm s10 c212529
    Gui, Add, Edit, x120 y66 w185 h26 vGuiPrefix gUpdatePreview +Left, %prefix%
    
    ; Next Number
    Gui, Font, b s9 c495057
    Gui, Add, Text, x20 y108 w90 h25 +0x200 +BackgroundTrans, NEXT NUMBER
    Gui, Font, Norm s10 c212529
    Gui, Add, Edit, x120 y106 w185 h26 vGuiNum Number gUpdatePreview +Left, %current_num%
    
    ; Suffix
    Gui, Font, b s9 c495057
    Gui, Add, Text, x20 y148 w90 h25 +0x200 +BackgroundTrans, SUFFIX
    Gui, Font, Norm s10 c212529
    Gui, Add, Edit, x120 y146 w185 h26 vGuiSuffix gUpdatePreview +Left, %suffix%
    
    ; Fixed Digit Length Info (Hindi na Dropdown para hindi magalaw ng user)
    Gui, Font, b s9 c495057
    Gui, Add, Text, x20 y188 w90 h25 +0x200 +BackgroundTrans, DIGIT LENGTH
    Gui, Font, m s10 c868E96
    Gui, Add, Text, x120 y188 w185 h25 +0x200 +BackgroundTrans, 7 Digits (Fixed Lock)
    
    ; --- PREMIUM LIVE PREVIEW DISPLAY ---
    Gui, Font, b s9 c0CA678
    Gui, Add, Text, x20 y232 w290 h18 +BackgroundTrans, LIVE PREVIEW (Click text to copy)
    
    current_preview := GenerateInvoice(prefix, current_num, suffix)
    Gui, Font, b s14 c0CA678  ; Premium Teal font flavor for the invoice
    Gui, Add, Text, x20 y252 w290 h38 Center vGuiPreview gCopyOnPreview +0x200, %current_preview%
    
    ; --- MODERN ACCENT ACTION BUTTONS ---
    Gui, Font, b s9 cFFFFFF
    ; Save Button (Elegant Teal Base)
    Gui, Add, Progress, x20 y312 w135 h34 Background0CA678, 100
    Gui, Add, Text, x20 y312 w135 h34 Center +0x200 +BackgroundTrans gSaveSettings, SAVE CHANGES
    
    ; Cancel Button (Clean Minimalist Gray Base)
    Gui, Add, Progress, x175 y312 w135 h34 BackgroundE9ECEF, 100
    Gui, Font, b s9 c495057
    Gui, Add, Text, x175 y312 w135 h34 Center +0x200 +BackgroundTrans gGuiClose, CANCEL
    
    ; Footer Status Tracking info
    Gui, Font, s8 cADB5BD
    Gui, Add, Text, x20 y360 w290 h15 +BackgroundTrans, Last active string output: %last_generated%
    
    ; Window Dragging Command (Para magalaw kahit borderless light mode)
    OnMessage(0x0201, "WM_LBUTTONDOWN")
    
    ; Premium Smooth Fade-In Animation
    DllCall("AnimateWindow", "UInt", GuiHwnd, "Int", 140, "UInt", 0xa0000)
    
    Gui, Show, w330 h390, InvoiceProLight
return

; --- SYSTEM INTERACTS & ACTIONS ---

WM_LBUTTONDOWN() {
    PostMessage, 0xA1, 2,,, A
}

UpdatePreview:
    Gui, Submit, NoHide 
    if (GuiNum == "") {
        GuiControl, +cFA5252, GuiPreview ; Soft Red Error Color
        GuiControl,, GuiPreview, [ ENTER NUMBER ]
        return
    }
    GuiControl, +c0CA678, GuiPreview ; Ibalik sa Premium Teal
    temp_preview := GenerateInvoice(GuiPrefix, GuiNum, GuiSuffix)
    GuiControl,, GuiPreview, %temp_preview%
return

CopyOnPreview:
    Gui, Submit, NoHide
    if (GuiNum != "") {
        copied_text := GenerateInvoice(GuiPrefix, GuiNum, GuiSuffix)
        Clipboard := copied_text
        ToolTip, Copied: %copied_text%
        SetTimer, RemoveToolTip, -1200
    }
return

SaveSettings:
    Gui, Submit
    if (GuiNum == "") {
        MsgBox, 48, System Notice, Please fill up the required next number digits.
        return
    }
    
    GuiNum := GuiNum + 0 
    IniWrite, %GuiPrefix%, settings.ini, Settings, Prefix
    IniWrite, %GuiNum%, settings.ini, Sequence, LastNumber
    IniWrite, %GuiSuffix%, settings.ini, Settings, Suffix
    
    LoadSettings()
    Gui, Destroy
return

GuiClose:
    DllCall("AnimateWindow", "UInt", GuiHwnd, "Int", 100, "UInt", 0x90000)
    Gui, Destroy
return
