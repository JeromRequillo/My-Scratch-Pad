<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Portfolio of Jerom Requillo, LPT.">
<meta property="og:title" content="Jerom Requillo | Licensed Professional Teacher">
<title>Jerom Requillo | Licensed Professional Teacher</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<style>
:root {
  --cyan: #00bcd4;
  --cyan-dark: #0097a7;
  --cyan-glow: rgba(0,188,212,0.15);
  --dark: #0d0d0d;
  --dark2: #141414;
  --dark3: #1e1e1e;
  --dark4: #2a2a2a;
  --text: #f0f0f0;
  --text-muted: #888;
  --text-dim: #555;
  --white: #ffffff;
  --gold: #f5c842;
  --light-bg: #f6f8f8;
  --card-bg: #ffffff;
  --card-border: #e8e8e8;
  --nav-bg: rgba(255,255,255,0.92);
  --body-bg: #f6f8f8;
  --body-text: #1a1a1a;
  --section-alt: #eef1f1;
}

body.dark-mode {
  --light-bg: #0d0d0d;
  --card-bg: #1e1e1e;
  --card-border: #2a2a2a;
  --nav-bg: rgba(13,13,13,0.95);
  --body-bg: #0d0d0d;
  --body-text: #e0e0e0;
  --section-alt: #141414;
  --text-muted: #777;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; scroll-padding-top: 75px; }

body {
  font-family: 'DM Sans', sans-serif;
  background: var(--body-bg);
  color: var(--body-text);
  overflow-x: hidden;
  transition: background 0.4s, color 0.4s;
}

/* === CURSOR === */
.cursor {
  width: 10px; height: 10px;
  background: var(--cyan);
  border-radius: 50%;
  position: fixed;
  pointer-events: none;
  z-index: 9999;
  transform: translate(-50%,-50%);
  transition: width 0.2s, height 0.2s, opacity 0.2s;
  mix-blend-mode: difference;
}
.cursor-ring {
  width: 36px; height: 36px;
  border: 1.5px solid var(--cyan);
  border-radius: 50%;
  position: fixed;
  pointer-events: none;
  z-index: 9998;
  transform: translate(-50%,-50%);
  transition: transform 0.12s ease-out, width 0.2s, height 0.2s;
  opacity: 0.5;
}

/* === NOISE OVERLAY === */
body::before {
  content:'';
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 0;
  opacity: 0.4;
}

/* === LOADING SCREEN === */
#loader {
  position: fixed; inset: 0;
  background: #0d0d0d;
  display: flex; align-items: center; justify-content: center;
  z-index: 10000;
  transition: opacity 0.6s, visibility 0.6s;
}
#loader.done { opacity: 0; visibility: hidden; }
.loader-inner {
  text-align: center;
}
.loader-name {
  font-family: 'Playfair Display', serif;
  font-size: 2rem;
  color: #fff;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  overflow: hidden;
}
.loader-name span {
  display: inline-block;
  animation: loaderChar 0.5s ease forwards;
  opacity: 0;
  transform: translateY(40px);
}
.loader-bar {
  width: 0;
  height: 2px;
  background: var(--cyan);
  margin: 12px auto 0;
  animation: loaderBarFill 1.8s ease forwards;
}
@keyframes loaderChar {
  to { opacity: 1; transform: translateY(0); }
}
@keyframes loaderBarFill {
  to { width: 200px; }
}

/* === NAV === */
nav {
  position: fixed; top: 0; width: 100%;
  background: var(--nav-bg);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(0,188,212,0.12);
  z-index: 1000;
  transition: background 0.4s, box-shadow 0.3s;
}
nav.scrolled { box-shadow: 0 4px 30px rgba(0,0,0,0.1); }
.nav-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  height: 70px;
  display: flex; align-items: center; justify-content: space-between;
}
.nav-logo {
  font-family: 'Playfair Display', serif;
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--cyan);
  text-decoration: none;
  letter-spacing: 0.02em;
}
.nav-links {
  list-style: none;
  display: flex; gap: 2rem;
}
.nav-links a {
  text-decoration: none;
  color: var(--body-text);
  font-size: 0.85rem;
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  position: relative;
  transition: color 0.3s;
}
.nav-links a::after {
  content: '';
  position: absolute;
  bottom: -4px; left: 0;
  width: 0; height: 1.5px;
  background: var(--cyan);
  transition: width 0.3s;
}
.nav-links a:hover { color: var(--cyan); }
.nav-links a:hover::after { width: 100%; }
.nav-links a.active { color: var(--cyan); }
.nav-links a.active::after { width: 100%; }

.nav-controls { display: flex; align-items: center; gap: 12px; }

.dark-toggle {
  width: 42px; height: 42px;
  border-radius: 50%;
  border: 1.5px solid var(--card-border);
  background: var(--card-bg);
  color: var(--body-text);
  cursor: pointer;
  transition: all 0.3s;
  display: flex; align-items: center; justify-content: center;
}
.dark-toggle:hover {
  border-color: var(--cyan);
  color: var(--cyan);
  transform: rotate(20deg);
}

.hamburger {
  display: none;
  flex-direction: column; gap: 5px;
  cursor: pointer; background: none; border: none;
  padding: 4px;
}
.hamburger span {
  width: 22px; height: 1.5px;
  background: var(--body-text);
  display: block;
  transition: all 0.3s;
}

/* === MOBILE NAV === */
.mobile-menu {
  position: fixed;
  top: 70px; left: 0; right: 0;
  background: var(--nav-bg);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--card-border);
  padding: 1.5rem 2rem;
  z-index: 999;
  transform: translateY(-110%);
  transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
}
.mobile-menu.open { transform: translateY(0); }
.mobile-menu ul { list-style: none; display: flex; flex-direction: column; gap: 1rem; }
.mobile-menu a {
  text-decoration: none; color: var(--body-text);
  font-size: 1rem; font-weight: 500;
  letter-spacing: 0.08em; text-transform: uppercase;
  transition: color 0.3s;
}
.mobile-menu a:hover { color: var(--cyan); }

/* === HERO === */
.hero {
  min-height: 100vh;
  background: var(--dark);
  position: relative;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}

.hero-bg-grid {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(0,188,212,0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,188,212,0.06) 1px, transparent 1px);
  background-size: 60px 60px;
  animation: gridMove 20s linear infinite;
}
@keyframes gridMove {
  0% { transform: translateY(0); }
  100% { transform: translateY(60px); }
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
}
.hero-orb-1 {
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(0,188,212,0.2), transparent 70%);
  top: -100px; right: -100px;
  animation: orbFloat 8s ease-in-out infinite;
}
.hero-orb-2 {
  width: 300px; height: 300px;
  background: radial-gradient(circle, rgba(245,200,66,0.1), transparent 70%);
  bottom: 50px; left: 100px;
  animation: orbFloat 11s ease-in-out infinite reverse;
}
@keyframes orbFloat {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-30px) scale(1.05); }
}

.hero-content {
  position: relative; z-index: 2;
  text-align: center; padding: 2rem;
  max-width: 800px;
}

.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--cyan); margin-bottom: 1.5rem;
  opacity: 0; animation: heroFadeUp 0.8s 0.5s ease forwards;
}
.hero-eyebrow::before, .hero-eyebrow::after {
  content: ''; width: 30px; height: 1px; background: var(--cyan);
}

.hero-name {
  font-family: 'Playfair Display', serif;
  font-size: clamp(3rem, 8vw, 5.5rem);
  font-weight: 900;
  color: var(--white);
  line-height: 1.05;
  margin-bottom: 1rem;
  opacity: 0; animation: heroFadeUp 0.8s 0.8s ease forwards;
}
.hero-name .highlight {
  color: var(--cyan);
  position: relative;
}

.hero-title {
  font-size: 1rem; letter-spacing: 0.08em;
  color: var(--text-muted);
  display: flex; align-items: center; justify-content: center;
  gap: 8px; margin-bottom: 2.5rem;
  opacity: 0; animation: heroFadeUp 0.8s 1.1s ease forwards;
}
.hero-title .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--cyan); }

.typing-text {
  font-size: 1rem;
  color: #fff;
  font-style: italic;
  min-height: 1.5em;
  margin-bottom: 2.5rem;
  opacity: 0; animation: heroFadeUp 0.8s 1.3s ease forwards;
}
.typing-cursor {
  display: inline-block;
  width: 2px; height: 1em;
  background: var(--cyan);
  vertical-align: middle;
  animation: cursorBlink 0.8s step-end infinite;
}
@keyframes cursorBlink { 50% { opacity: 0; } }

.hero-cta {
  display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;
  opacity: 0; animation: heroFadeUp 0.8s 1.6s ease forwards;
}

@keyframes heroFadeUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}

.btn-primary {
  padding: 14px 36px;
  background: var(--cyan);
  color: #000;
  text-decoration: none;
  border-radius: 4px;
  font-weight: 600;
  font-size: 0.9rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  border: none; cursor: pointer;
  position: relative; overflow: hidden;
  transition: transform 0.2s, box-shadow 0.3s;
}
.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 30px rgba(0,188,212,0.4);
}
.btn-primary::after {
  content: '';
  position: absolute; inset: 0;
  background: rgba(255,255,255,0.1);
  transform: scaleX(0); transform-origin: left;
  transition: transform 0.3s;
}
.btn-primary:hover::after { transform: scaleX(1); }

.btn-secondary {
  padding: 13px 36px;
  background: transparent;
  color: var(--white);
  text-decoration: none;
  border-radius: 4px;
  font-weight: 500;
  font-size: 0.9rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  border: 1.5px solid rgba(255,255,255,0.25);
  cursor: pointer;
  transition: border-color 0.3s, color 0.3s;
}
.btn-secondary:hover {
  border-color: var(--cyan);
  color: var(--cyan);
}

.hero-scroll-hint {
  position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  color: var(--text-dim); font-size: 0.7rem; letter-spacing: 0.1em;
  text-transform: uppercase;
  opacity: 0; animation: heroFadeUp 1s 2s ease forwards;
}
.scroll-line {
  width: 1px; height: 40px;
  background: linear-gradient(to bottom, var(--cyan), transparent);
  animation: scrollLine 1.5s ease-in-out infinite;
}
@keyframes scrollLine {
  0%, 100% { transform: scaleY(1); opacity: 1; }
  50% { transform: scaleY(0.5); opacity: 0.4; }
}

/* === STATS BAR === */
.stats-bar {
  background: var(--dark2);
  padding: 2rem 10%;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 2rem;
  border-bottom: 1px solid rgba(0,188,212,0.1);
}
body:not(.dark-mode) .stats-bar {
  background: #0d0d0d;
}
.stat-item { text-align: center; }
.stat-number {
  font-family: 'Playfair Display', serif;
  font-size: 2.5rem; font-weight: 700;
  color: var(--cyan);
  line-height: 1;
}
.stat-label {
  font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--text-muted); margin-top: 4px;
}

/* === SECTION BASE === */
section {
  padding: 100px 10%;
  position: relative;
}

.section-tag {
  display: inline-block;
  font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--cyan);
  margin-bottom: 0.75rem;
  position: relative; padding-left: 24px;
}
.section-tag::before {
  content: '';
  position: absolute; left: 0; top: 50%;
  width: 16px; height: 1.5px;
  background: var(--cyan);
  transform: translateY(-50%);
}

.section-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 700;
  line-height: 1.15;
  color: var(--body-text);
  margin-bottom: 1rem;
}

/* === ABOUT SECTION === */
.about-section {
  background: var(--body-bg);
}

.about-grid {
  display: grid;
  grid-template-columns: 320px 1fr;
  gap: 60px;
  align-items: start;
  margin-top: 60px;
}

.about-left { position: sticky; top: 100px; }

.profile-card {
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  border-radius: 16px;
  overflow: hidden;
  transition: transform 0.3s, box-shadow 0.3s;
}
.profile-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 50px rgba(0,188,212,0.15);
}

.profile-img-wrap {
  position: relative;
  overflow: hidden;
}
.profile-img-wrap::after {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(to bottom, transparent 60%, rgba(0,188,212,0.2));
}
.profile-pic {
  width: 100%;
  aspect-ratio: 1;
  object-fit: cover;
  display: block;
  transition: transform 0.4s;
}
.profile-card:hover .profile-pic { transform: scale(1.04); }

.profile-info {
  padding: 1.5rem;
}
.profile-name {
  font-family: 'Playfair Display', serif;
  font-size: 1.4rem; font-weight: 700;
  color: var(--body-text); margin-bottom: 4px;
}
.profile-badge {
  display: inline-block;
  padding: 4px 12px;
  background: rgba(0,188,212,0.12);
  color: var(--cyan);
  border-radius: 20px;
  font-size: 0.75rem; font-weight: 600;
  letter-spacing: 0.05em;
  margin-bottom: 1rem;
}
.info-row {
  display: flex; align-items: flex-start; gap: 10px;
  font-size: 0.82rem;
  color: var(--text-muted);
  margin-bottom: 8px;
  line-height: 1.5;
}
.info-row i { color: var(--cyan); margin-top: 2px; flex-shrink: 0; }

.download-btn {
  display: block;
  width: 100%;
  padding: 12px;
  margin-top: 1.25rem;
  background: var(--cyan);
  color: #000;
  text-decoration: none;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.85rem;
  text-align: center;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  transition: background 0.3s, transform 0.2s;
}
.download-btn:hover {
  background: var(--cyan-dark);
  transform: translateY(-1px);
}
.download-btn i { margin-right: 8px; }

.about-right {}

.about-intro {
  font-size: 1.05rem;
  line-height: 1.8;
  color: var(--body-text);
  margin-bottom: 1.5rem;
}
.about-intro strong { color: var(--cyan); font-weight: 600; }

/* === TIMELINE === */
.timeline-section-title {
  font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase;
  color: var(--text-muted); margin: 2.5rem 0 1.25rem;
  display: flex; align-items: center; gap: 12px;
}
.timeline-section-title::after {
  content: ''; flex: 1; height: 1px;
  background: var(--card-border);
}

.timeline {
  position: relative; padding-left: 20px;
}
.timeline::before {
  content: '';
  position: absolute; left: 0; top: 8px; bottom: 8px;
  width: 1.5px;
  background: linear-gradient(to bottom, var(--cyan), transparent);
}

.timeline-item {
  position: relative; padding-left: 24px; margin-bottom: 28px;
  transition: all 0.3s;
}
.timeline-item::before {
  content: '';
  position: absolute; left: -7px; top: 6px;
  width: 8px; height: 8px;
  background: var(--cyan);
  border-radius: 50%;
  box-shadow: 0 0 0 3px var(--body-bg), 0 0 0 5px rgba(0,188,212,0.25);
}
.timeline-item:hover { padding-left: 30px; }

.timeline-date {
  font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--cyan); margin-bottom: 4px;
}
.timeline-role {
  font-size: 1rem; font-weight: 600;
  color: var(--body-text); margin-bottom: 2px;
}
.timeline-org {
  font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px;
}
.timeline-desc {
  font-size: 0.85rem; line-height: 1.7; color: var(--body-text);
}
.timeline-list {
  list-style: none; padding: 0;
}
.timeline-list li {
  font-size: 0.82rem; line-height: 1.7; color: var(--body-text);
  padding-left: 14px; position: relative; margin-bottom: 3px;
}
.timeline-list li::before {
  content: '→';
  position: absolute; left: 0;
  color: var(--cyan); font-size: 0.75rem;
}

/* === CERTS === */
.cert-list { list-style: none; padding: 0; margin-top: 1rem; }
.cert-list li {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 14px;
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  border-radius: 8px;
  margin-bottom: 8px;
  font-size: 0.85rem;
  transition: border-color 0.3s, transform 0.2s;
}
.cert-list li:hover {
  border-color: var(--cyan);
  transform: translateX(4px);
}
.cert-list li i {
  color: var(--cyan); font-size: 1rem; flex-shrink: 0;
}

/* === SKILLS === */
.skills-section {
  background: var(--section-alt);
}

.skills-layout {
  margin-top: 60px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
}

.competency-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.skill-card {
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  border-radius: 10px;
  padding: 14px 16px;
  display: flex; align-items: center; gap: 12px;
  cursor: pointer;
  transition: all 0.25s;
  font-size: 0.84rem; font-weight: 500;
  color: var(--body-text);
}
.skill-card i { color: var(--cyan); font-size: 1rem; }
.skill-card:hover {
  border-color: var(--cyan);
  background: rgba(0,188,212,0.06);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0,188,212,0.12);
  color: var(--cyan);
}

.proficiency-bars {}
.proficiency-item { margin-bottom: 24px; }
.proficiency-header {
  display: flex; justify-content: space-between;
  margin-bottom: 8px;
  font-size: 0.85rem; font-weight: 500;
}
.proficiency-pct { color: var(--cyan); }
.progress-track {
  height: 6px;
  background: var(--card-border);
  border-radius: 6px; overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--cyan), #00e5ff);
  border-radius: 6px;
  width: 0;
  transition: width 1.4s cubic-bezier(0.4,0,0.2,1);
}

/* === PHILOSOPHY === */
.philosophy-section {
  background: var(--dark);
  color: var(--white);
  text-align: center;
}
.philosophy-section .section-title { color: var(--white); }

.philosophy-quote {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  line-height: 1.5;
  color: rgba(255,255,255,0.85);
  max-width: 780px;
  margin: 0 auto 2rem;
  font-style: italic;
}
.philosophy-body {
  max-width: 680px;
  margin: 0 auto;
  font-size: 1rem;
  line-height: 1.9;
  color: rgba(255,255,255,0.6);
}

.philosophy-pillars {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  max-width: 900px;
  margin: 3rem auto 0;
}
.pillar {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(0,188,212,0.15);
  border-radius: 12px;
  padding: 2rem 1.5rem;
  text-align: center;
  transition: border-color 0.3s, background 0.3s;
}
.pillar:hover {
  border-color: var(--cyan);
  background: rgba(0,188,212,0.08);
}
.pillar-icon {
  width: 50px; height: 50px;
  border-radius: 12px;
  background: rgba(0,188,212,0.15);
