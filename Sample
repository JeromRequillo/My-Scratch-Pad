#NoEnv
#SingleInstance Force
SendMode Input
SetWorkingDir %A_ScriptDir%

global current_num, prefix, suffix, last_generated := "None"
global GuiHwnd

LoadSettings()
return 

; --- FUNCTIONS ---

LoadSettings() {
    global current_num, prefix, suffix
    IniRead, current_num, settings.ini, Sequence, LastNumber, 00000
    IniRead, prefix, settings.ini, Settings, Prefix, AAPI
    IniRead, suffix, settings.ini, Settings, Suffix, S
}

GenerateInvoice(p := "", n := 0, s := "") {
    global prefix, current_num, suffix
    target_prefix := (p == "") ? prefix : p
    target_num := (n == 0) ? current_num : n
    target_suffix := (s == "") ? suffix : s
    
    formatted_num := Format("{:07}", target_num)
    return target_prefix . formatted_num . target_suffix
}

; --- HOTKEYS ---

!F9::
    Critical 
    invoice_string := GenerateInvoice()
    SendInput, %invoice_string%
    
    SoundBeep, 750, 50 
    ToolTip, Sent: %invoice_string%
    SetTimer, RemoveToolTip, -2000
    
    last_generated := invoice_string
    current_num += 1
    IniWrite, %current_num%, settings.ini, Sequence, LastNumber
    IniWrite, %last_generated%, settings.ini, Sequence, LastGenerated
return

RemoveToolTip:
    ToolTip
return

; --- BORDERLESS PREMIUM LIGHT GUI (Alt + F10) ---

!F10::
    LoadSettings() 
    Gui, Destroy 
    
    Gui, +LastFound -Caption +AlwaysOnTop +HwndGuiHwnd
    
    ; --- PREMIUM LIGHT PALETTE ---
    ; Window Background: #F8F9FA (Soft Off-White/Platinum)
    ; Control Background: #FFFFFF (Pure White)
    Gui, Color, F8F9FA, FFFFFF 
    
    ; --- CUSTOM TITLE BAR ---
    ; Text Color: #4A5568 (Deep Slate/Charcoal)
    Gui, Font, b s10 c4A5568, Segoe UI
    Gui, Add, Text, x15 y12 w200 h20 +BackgroundTrans vTitleText, INVOICE SERIES MANAGER 
    
    ; Custom Modern Close Button (X) sa sulok (#E53E3E - Soft Red)
    Gui, Font, b s12 cE53E3E
    Gui, Add, Text, x300 y10 w25 h20 Center gGuiClose +BackgroundTrans, ×
    
    ; Decorative Top Divider Line (#4F46E5 - Premium Indigo Accent)
    Gui, Add, Progress, x0 y38 w330 h3 Background4F46E5 c4F46E5, 100
    
    ; --- MAIN CONTROLS ---
    ; Text labels: #4A5568 (Charcoal)
    Gui, Font, Norm s10 c4A5568, Segoe UI
    
    ; Prefix Field
    Gui, Add, Text, x20 y60 w90 h25 +0x200, Prefix
    Gui, Add, Edit, x120 y58 w185 h26 c1A202C vGuiPrefix gUpdatePreview, %prefix%
    
    ; Next Number Field
    Gui, Add, Text, x20 y100 w90 h25 +0x200, Next Number
    Gui, Add, Edit, x120 y98 w185 h26 c1A202C vGuiNum Number gUpdatePreview, %current_num%
    
    ; Suffix Field
    Gui, Add, Text, x20 y140 w90 h25 +0x200, Suffix
    Gui, Add, Edit, x120 y138 w185 h26 c1A202C vGuiSuffix gUpdatePreview, %suffix%
    
    ; --- FLAT LIVE PREVIEW BOX ---
    Gui, Font, b s9 c4F46E5
    Gui, Add, Text, x20 y185 w290 h18 +BackgroundTrans, PREVIEW (Click text to copy instantly)
    
    current_preview := GenerateInvoice(prefix, current_num, suffix)
    ; Text Preview Accent: #B7791F (Premium Champagne Gold)
    Gui, Font, b s14 cB7791F
    Gui, Add, Text, x20 y205 w290 h35 Center vGuiPreview gCopyOnPreview +0x200 +Border, %current_preview%
    
    ; --- APP FOOTER ACTION BUTTONS ---
    Gui, Font, Norm s10 c4A5568
    Gui, Add, Button, x20 y265 w135 h35 gSaveSettings +Default, SAVE CHANGES
    Gui, Add, Button, x175 y265 w135 h35 gGuiClose, CANCEL
    
    ; Status Label Text  (#718096 - Muted Gray)
    Gui, Font, s8 c718096
    Gui, Add, Text, x20 y315 w290 h15 +BackgroundTrans, Last Active String: %last_generated%
    
    ; --- SYSTEM CREDITS & DOWNLOAD FOOTER ---
    Gui, Font, s8 c718096
    Gui, Add, Text, x20 y342 w150 h15 +BackgroundTrans, Developer: Jerom Requillo
    
    ; Clickable Link (Indigo Accent with Underline)
    Gui, Font, b s8 c4F46E5 U
    Gui, Add, Text, x210 y342 w100 h15 Right gOpenGitHub +BackgroundTrans, Download Updates
    
    ; Intercept click for borderless window drag
    OnMessage(0x0201, "WM_LBUTTONDOWN")
    
    ; Smooth Fade-In
    DllCall("AnimateWindow", "UInt", GuiHwnd, "Int", 150, "UInt", 0xa0000)
    
    ; In-adjust ang height mula 345 naging 370 para kumasya ang bagong info sa pinaka-ilalim
    Gui, Show, w330 h370, InvoicePro
return

; --- SYSTEM INTERACTS & ACTIONS ---

WM_LBUTTONDOWN() {
    PostMessage, 0xA1, 2,,, A
}

UpdatePreview:
    Gui, Submit, NoHide 
    if (GuiNum == "") {
        GuiControl, +cE53E3E, GuiPreview
        GuiControl,, Preview, [ INPUT NUMBER ]
        return
    }
    GuiControl, +cB7791F, GuiPreview
    temp_preview := GenerateInvoice(GuiPrefix, GuiNum, GuiSuffix)
    GuiControl,, GuiPreview, %temp_preview%
return

CopyOnPreview:
    Gui, Submit, NoHide
    if (GuiNum != "") {
        copied_text := GenerateInvoice(GuiPrefix, GuiNum, GuiSuffix)
        Clipboard := copied_text
        ToolTip, Copied to Clipboard: %copied_text%
        SetTimer, RemoveToolTip, -1200
    }
return

SaveSettings:
    Gui, Submit
    if (GuiNum == "") {
        MsgBox, 48, Application Error, Please input a valid starting number sequence.
        return
    }
    
    GuiNum := GuiNum + 0 
    IniWrite, %GuiPrefix%, settings.ini, Settings, Prefix
    IniWrite, %GuiNum%, settings.ini, Sequence, LastNumber
    IniWrite, %GuiSuffix%, settings.ini, Settings, Suffix
    
    LoadSettings()
    Gui, Destroy
return

GuiClose:
    DllCall("AnimateWindow", "UInt", GuiHwnd, "Int", 100, "UInt", 0x90000)
    Gui, Destroy
return

OpenGitHub:
    Run, https://github.com/JeromRequillo/Auto-Incrementing-Generator
return
